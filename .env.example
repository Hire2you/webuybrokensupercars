# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender must use your verified Resend domain (webuybrokenjaguars.com)
RESEND_FROM_EMAIL=We Buy Broken Jaguars <valuations@webuybrokenjaguars.com>

# Inbox that receives new valuation leads (defaults to sales@webuybrokenjaguars.com)
RESEND_TO_EMAIL=sales@webuybrokenjaguars.com

# Optional second inbox while sales@ mailbox is being set up (e.g. your Gmail)
RESEND_BACKUP_TO_EMAIL=you@example.com
