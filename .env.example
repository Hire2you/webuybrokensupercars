# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender must use your verified Resend domain (webuybrokensupercars.co.uk)
RESEND_FROM_EMAIL=We Buy Broken Supercars <valuations@webuybrokensupercars.co.uk>

# Inbox that receives new valuation leads (defaults to sales@webuybrokensupercars.co.uk)
RESEND_TO_EMAIL=sales@webuybrokensupercars.co.uk

# Optional second inbox while sales@ mailbox is being set up (e.g. your Gmail)
RESEND_BACKUP_TO_EMAIL=you@example.com

# Public site URL (used for metadata, emails, and schema)
NEXT_PUBLIC_SITE_URL=https://webuybrokensupercars.co.uk
